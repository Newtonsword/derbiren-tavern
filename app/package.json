{
  "name": "monster-dungeon-tavern",
  "version": "1.0.0",
  "description": "小魔王地下城 · Monster Dungeon Tavern 桌面版（纯前端，玩家自带 DeepSeek key）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.newt.monsterdungeontavern",
    "productName": "小魔王地下城",
    "files": [
      "main.js",
      "../web/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.6.3"
  }
}
